# =============================================================================
# cluster.env.example — GPU クラスタ接続設定のテンプレート
# =============================================================================
# 使い方:
#   cp infra/k8s/cluster.env.example infra/k8s/cluster.env
#   vi infra/k8s/cluster.env          # ← 自分のクラスタの値で埋める
#
# ⚠ cluster.env は .gitignore に入れる（クラスタ名・PVC 名は社内情報のことが多い）。
# ⚠ **認証情報はここに書かない**。API キーの類は repo root の `.env` に置き、
#   Job は起動時に `.env` を source する（job.template.yaml 参照）。
# =============================================================================

# --- クラスタ / キュー --------------------------------------------------------
PAI_NAMESPACE="{{NAMESPACE}}"                 # 例: factory-ai-dev
PAI_QUEUE_NAME="{{KUEUE_LOCAL_QUEUE}}"        # 例: lq-factory-ai-dev（Kueue を使わないなら空）

# --- Job の名前 ---------------------------------------------------------------
# ⚠ 社内ダッシュボードの「全 namespace のジョブ一覧」に他チームと並んで表示される。
#   コンペ名や個人名をそのまま出さない中立な接頭辞にしておくと角が立たない。
#   （実例: `rsna-run-xxxxx` → `physical-ai-run-xxxxx` に改名した）
# ⚠ 運用コマンドのセレクタは `job=<name>` ラベルなので、接頭辞を変えても手順は変わらない。
PAI_JOB_PREFIX="{{JOB_PREFIX}}"               # 例: physical-ai
PAI_APP_LABEL="{{APP_LABEL}}"                 # 例: physical-ai

# --- image --------------------------------------------------------------------
# ⚠ image 内 python のバージョンは venv を作った python と一致させる。
# ⚠ **巨大 image は Kueue の PodsReady 期限に引っかかる**。cold node で pull に 25 分かかり、
#   30 分期限を超えて job が deactivated になった実例がある（18 job が一晩で死んだ）。
#   → torch の cu wheel は CUDA ランタイムを同梱するので、**薄い base image + PVC 上の venv** が速い。
PAI_IMAGE="${PAI_IMAGE:-ubuntu:22.04}"
PAI_IMAGE_PULL_SECRET=""                      # private registry を使うときだけ設定

# --- repo / ストレージ ---------------------------------------------------------
PAI_PROJECT_DIR="{{PROJECT_DIR_ON_PVC}}"      # 例: /volume/study/MyCompetition
PAI_DATA_PVC="{{DATA_PVC_NAME}}"              # repo と data を載せた PVC
PAI_DATA_MOUNT="{{DATA_MOUNT_PATH}}"          # 例: /volume
PAI_HOME_PVC="{{HOME_PVC_NAME}}"              # HOME を載せた PVC（無ければ空にして job.template から削る）
PAI_HOME_MOUNT="{{HOME_MOUNT_PATH}}"          # 例: /home/jovyan

# --- 実行ユーザ ----------------------------------------------------------------
# ⚠ public image は既定 root。開発 Pod と uid/gid を合わせないと、
#   共有ストレージに **root 所有のファイル**が生まれて後から触れなくなる。
PAI_UID="1000"
PAI_GID="0"
PAI_FSGROUP="100"
PAI_HOME="{{HOME_MOUNT_PATH}}"                # ⚠ 既定 /root のままだと PVC 上の設定を見失う
PAI_USER="{{POD_USER_NAME}}"                  # 例: jovyan
# ⚠ public image の /etc/passwd に uid 1000 が無いと `getpass.getuser()` が
#   KeyError で落ちる（torch._inductor がキャッシュ dir 名を作るのに呼ぶ）。
#   getuser() は USER/LOGNAME を pwd より先に見るので、env で与えれば解決する。

# --- python ---------------------------------------------------------------------
# ⚠ **2 つの venv を使い分ける**。
#   .venv      … image 内 python を指す。開発 Pod でのみ使える
#   .venv-k8s  … PVC 上の python を指す。image に依存しないので Job で使える
PAI_PY=".venv-k8s/bin/python"

# --- リソース --------------------------------------------------------------------
PAI_CPU="16"
PAI_MEM="96Gi"
PAI_SHM="32Gi"                                 # /dev/shm（DataLoader worker + cache 置き場）
PAI_GPU_TOLERATION_KEY="{{GPU_TAINT_KEY}}"    # 例: nvidia-h100-80gb（taint が無ければ空）

# --- GPU 使用上限（共有クラスタの作法）--------------------------------------------
# ⚠ 共有クラスタでは「いま何枚まで使ってよいか」を決めておく。
#   超えたいときは空き状況を確認してから、その回だけ PAI_MAX_GPU=<新上限> を付けて投げる。
PAI_MAX_GPU="8"

# --- 実験管理 ----------------------------------------------------------------------
PAI_TRAIN_SCRIPT="src/scripts/200_train_model/200_train_model.py"
WANDB_PROJECT="{{WANDB_PROJECT}}"
WANDB_ENTITY="{{WANDB_ENTITY}}"
WANDB_BASE_URL=""                              # 社内 W&B を使うときだけ設定
